{% extends "_layouts/cp" %}
{% set selectedSubnavItem = 'settings' %}

{% requireAdmin %}

{% set title = "Settings"|t('app') %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% set navItems = {
    'settings': { title: "General"|t('app') },
    'licenses-heading': { heading: "Licenses"|t('digital-products') },
    'licenses': { title: "License Fields"|t('digital-products') },
    'producttypes-heading': { heading: "Products"|t('digital-products') },
    'producttypes': { title: "Product Types"|t('digital-products') },
} %}

{# Segment 2 covers /producttypes/..., segment 3 covers /settings/licenses etc. #}
{% if selectedItem is not defined %}
    {% set seg2 = craft.app.request.getSegment(2) %}
    {% set seg3 = craft.app.request.getSegment(3) %}
    {% set selectedItem = seg2 == 'producttypes' ? 'producttypes' : (seg3 ?: 'settings') %}
{% endif %}

{% set docTitle = navItems[selectedItem].title ~ ' - ' ~ title %}

{% block sidebar %}
    <nav>
        <ul>
            {% for handle, item in navItems %}
                {% if item.heading is defined %}
                    <li class="heading"><span>{{ item.heading }}</span></li>
                {% else %}
                    {% if handle == 'producttypes' %}
                        {% set href = url('digital-products/producttypes') %}
                    {% elseif handle == 'settings' %}
                        {% set href = url('digital-products/settings') %}
                    {% else %}
                        {% set href = url('digital-products/settings/' ~ handle) %}
                    {% endif %}
                    <li>
                        <a href="{{ href }}"{% if handle == selectedItem %} class="sel"{% endif %}>{{ item.title }}</a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
{% endblock %}
