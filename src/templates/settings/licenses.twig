{% extends "digital-products/settings/_layout" %}

{% import "_includes/forms" as forms %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}

{% block content %}
    <form method="post" accept-charset="UTF-8" data-saveshortcut data-confirm-unload>
        {% if not readOnly %}
            {{ actionInput('digital-products/settings/save-license-field-layout') }}
            {{ redirectInput('digital-products/settings/licenses') }}
        {% endif %}
        {{ csrfInput() }}

        {{ forms.fieldLayoutDesignerField({
            first: true,
            fieldLayout: craft.app.fields.getLayoutByType('craft\\digitalproducts\\elements\\License'),
            disabled: readOnly,
        }) }}

        {% if not readOnly %}
            <div class="buttons">
                <button type="submit" class="btn submit">{{ 'Save'|t('app') }}</button>
            </div>
        {% endif %}
    </form>
{% endblock %}
